# Konfiguration für Produktions-Builds.
#
# Diese beiden Werte sind KEINE Geheimnisse und gehören bewusst ins Repo:
#
#   - Der Publishable Key landet zwangsläufig im ausgelieferten JavaScript.
#     Das ist sein Zweck — jeder Besucher der Seite kann ihn lesen. Geheim
#     halten lässt er sich gar nicht.
#   - Geschützt werden die Daten nicht durch Geheimhaltung, sondern durch
#     Row Level Security in Postgres. Siehe supabase/setup.sql und die
#     Gegenprobe in supabase/verify.sql.
#
# NIEMALS hierher gehört der Secret Key (sb_secret_…). Der umgeht RLS
# vollständig und darf den Server nie verlassen.
#
# Vorrang: Echte Umgebungsvariablen (z. B. aus Vercel) gewinnen gegen diese
# Datei — Vite überschreibt vorhandene Werte nicht. Wer später ein zweites
# Supabase-Projekt anbinden will, setzt sie einfach im Hosting und muss hier
# nichts ändern.

VITE_SUPABASE_URL=https://cnuscpmohyfyoukgrbui.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_Dy5n-IVCyHKMBC_hqhTYgQ_4tcN_GGw
